#!/bin/bash
# /usr/local/sbin/alerta-smartd — segue o journal do smartd e manda os avisos
# graves (prioridade 0-3) para o telemóvel via /usr/local/sbin/alerta.
# Tarefa 21 (home-server), plano B: o SELinux não deixa o smartd (-M exec, domínio
# smartdwarn_t) ir à rede, por isso o envio corre aqui, num serviço systemd normal
# (alerta-smartd.service). O smartd.conf fica como o RHEL o deixou.
#
# 2026-11-27 (Ivan): só avisa quando há NOVIDADE. Cada aviso é identificado pelo
# texto com os números soltos trocados por N (disco + tipo de aviso); guarda-se o
# último texto de cada um em /var/lib/alerta-smartd (sobrevive a reinícios).
# Envia se o aviso é novo ou se o valor mudou (ex.: 30 → 31 setores pendentes);
# a mesma linha repetida pelo smartd a cada 30 min nunca volta a ser enviada.
# Antes: o mesmo texto era reenviado de 6 em 6 h (~4 alertas/dia do WD com 30).
# Repor o aviso de um disco: apagar o ficheiro dele em /var/lib/alerta-smartd.

set -u
JANELA=5
ESTADO=/var/lib/alerta-smartd
mkdir -p "$ESTADO"

novidade() {   # devolve 0 (e regista) se a linha é nova ou mudou de valor
  local linha=$1 chave
  chave=$(printf '%s' "$linha" | sed -E 's/\b[0-9]+\b/N/g' | sha1sum | cut -c1-16)
  if [[ -f $ESTADO/$chave && $(<"$ESTADO/$chave") == "$linha" ]]; then
    return 1
  fi
  printf '%s' "$linha" > "$ESTADO/$chave"
  return 0
}

enviar() {
  local lote=$1 linha novas=""
  while IFS= read -r linha; do
    [[ -z $linha ]] && continue
    if novidade "$linha"; then
      novas+=${novas:+$'\n'}$linha
    else
      echo "sem alteração, não enviado: $linha"
    fi
  done <<<"$lote"
  [[ -z $novas ]] && return
  echo "ENVIADO: ${novas%%$'\n'*}"
  printf '%s\n' "$novas" | /usr/local/sbin/alerta -p 5 -t rotating_light,floppy_disk "SMART: aviso novo do smartd"
}

journalctl --follow --lines=0 --identifier=smartd --priority=0..3 --output=cat |
while IFS= read -r linha; do
  lote=$linha
  while IFS= read -r -t "$JANELA" linha; do lote+=$'\n'$linha; done
  enviar "$lote"
done
